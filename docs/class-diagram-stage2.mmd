Main ..> GameController : creates
Main ..> Stage2Arrivals : selects
GameController ..> GameConfig : reads
GameController "1" --> "1" ConsoleUI : uses
GameController "1" --> "1" Restaurant : coordinates
Restaurant "1" *-- "2" Table : owns
Restaurant "1" *-- "1" Menu : owns
Restaurant "1" --> "0..*" Customer : registry; queue is a subset
Restaurant "1" --> "0..*" Order : active orders
Staff <|-- Waiter
Staff <|-- Chef
Staff <|-- Cashier
Customer <|-- RegularCustomer
Customer <|-- VIPCustomer
Customer <|-- CriticCustomer
Table "0..1" -- "0..1" Customer : current seating
Customer "1" -- "0..1" Order : places
Menu "1" *-- "3" MenuItem : base items
Order "0..*" --> "1" MenuItem : ordered item
Customer ..> CustomerState : state
Order ..> OrderStatus : status
Restaurant "1" *-- "1" Waiter : waiter
Restaurant "1" *-- "1" Chef : chef
Restaurant "1" *-- "1" Cashier : cashier
Stage2Arrivals ..> Customer : creates
note for Customer "Encapsulation: private state changes through domain operations; waiting loss uses polymorphism (8/5/12)."
note for VIPCustomer "90 percent quote in cents, half-up rounding with long arithmetic; no mutation of menu prices."
note for CriticCustomer "Always Pasta. ID 4 differs from the Regular ID 4 Salad choice."
note for Order "lockedPriceCents is readOnly: quote once during construction; Cashier never reprices."
note for Restaurant "Composition: owns two tables, one menu and one employee per role. Six arrivals in the configured run."
note for GameController "arrivalFactory selects customer creation; no type-check chains for pricing or waiting rules."
note for ConsoleUI "stageLabel is display metadata. Old constructors retain Stage 1."
