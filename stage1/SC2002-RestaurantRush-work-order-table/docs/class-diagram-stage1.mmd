classDiagram
direction TB

class Main {
    +main(args: String[]) void$
}
class GameConfig {
    +int MAX_TURNS$
    +int TABLE_COUNT$
    +int MIN_PAID_CUSTOMERS$
    +int MIN_REVENUE_CENTS$
    +int MIN_AVERAGE_SATISFACTION$
    +List~Integer~ ARRIVAL_TURNS$
}
class ConsoleUI {
    <<boundary>>
    -Scanner input
    -PrintStream output
    +showWelcome() void
    +readCommand() String
    +showHelp() void
    +showTasks() void
    +showMenu(menu: Menu) void
    +showTurnState(restaurant: Restaurant) void
    +showMessage(text: String) void
    +showResult(restaurant: Restaurant, victory: boolean) void
}
class GameController {
    <<control>>
    -Restaurant restaurant
    -ConsoleUI ui
    +run() void
    -processTurn() void
    -processArrivals() void
    -processWaiterChoice() void
    -processChefChoice() void
    -processEatingAndPayments() void
    -processWaitingAndAbandonment() void
    -resetStaffActions() void
    -checkVictory() boolean
}
class Restaurant {
    <<entity>>
    -List~Table~ tables
    -Queue~Customer~ waitingQueue
    -List~Customer~ customers
    -List~Order~ activeOrders
    -Menu menu
    -Waiter waiter
    -Chef chef
    -Cashier cashier
    -int turn
    -int servedCount
    -int unhappyDepartures
    +getTables() List~Table~
    +getWaitingQueue() List~Customer~
    +getCustomers() List~Customer~
    +getActiveOrders() List~Order~
    +getMenu() Menu
    +getWaiter() Waiter
    +getChef() Chef
    +getCashier() Cashier
    +getTurn() int
    +getServedCount() int
    +getUnhappyDepartures() int
    +findFreeTable() Table
    +findQueuedCustomer(id: int) Customer
    +nextTurn() void
    +addArrival(customer: Customer) void
    +removeFromQueue(customer: Customer) void
    +addOrder(order: Order) void
    +removeOrder(order: Order) void
    +recordServed() void
    +handleDeparture(customer: Customer) void
}
class Staff {
    <<abstract>>
    -boolean actedThisTurn
    +hasActed() boolean
    +resetTurn() void
    +skipTurn() void
    #requireAvailable() void
    #markActed() void
}
class Waiter {
    +seat(customer: Customer, table: Table) void
    +takeOrder(customer: Customer, menu: Menu) Order
    +serve(order: Order, turn: int) void
}
class Chef {
    +advance(order: Order, turn: int) void
}
class Cashier {
    -int revenueCents
    -List~Integer~ paidSatisfactions
    +getRevenueCents() int
    +getPaidCount() int
    +getAverageSatisfaction() double
    +collectPayment(customer: Customer, turn: int) int
}
class Customer {
    <<abstract>>
    -int id
    -int satisfaction
    -CustomerState state
    -Table table
    -Order order
    -int servedTurn
    -int readyToPayTurn
    +getId() int
    +getSatisfaction() int
    +getState() CustomerState
    +getTable() Table
    +getOrder() Order
    +getServedTurn() int
    +getReadyToPayTurn() int
    +waitingLoss() int*
    +loseWaitingSatisfaction() void
    +chooseMeal(menu: Menu) MenuItem
    +seat(table: Table) void
    +placeOrder(order: Order) void
    +markServed(turn: int) void
    +finishEating(turn: int) void
    +canPay(turn: int) boolean
    +markPaid() void
    +leave() void
}
class RegularCustomer {
    +waitingLoss() int
}
class Table {
    -int number
    -Customer occupant
    +getNumber() int
    +getOccupant() Customer
    +isFree() boolean
    +seat(customer: Customer) void
    +release() void
}
class Order {
    -Customer customer
    -MenuItem item
    -int lockedPriceCents
    -int unitsDone
    -OrderStatus status
    -int readyTurn
    +getCustomer() Customer
    +getItem() MenuItem
    +getLockedPriceCents() int
    +getUnitsDone() int
    +getStatus() OrderStatus
    +getReadyTurn() int
    +advance(turn: int) void
    +isServable(turn: int) boolean
    +markServed() void
    +markPaid() void
    +cancel() void
}
class Menu {
    -List~MenuItem~ items
    +getItems() List~MenuItem~
    +find(name: String) MenuItem
}
class MenuItem {
    -String name
    -int priceCents
    -int prepUnits
    +getName() String
    +getPriceCents() int
    +getPrepUnits() int
}
class CustomerState {
    <<enumeration>>
    QUEUED
    SEATED
    SERVED
    READY_TO_PAY
    PAID
    LEFT
}
class OrderStatus {
    <<enumeration>>
    PLACED
    PREPARING
    READY
    SERVED
    PAID
    CANCELLED
}

Main ..> GameController
Main ..> Restaurant
Main ..> ConsoleUI
ConsoleUI ..> GameConfig
GameController "1" --> "1" ConsoleUI : uses
GameController "1" --> "1" Restaurant : manages
Restaurant "1" *-- "2" Table : owns
Restaurant "1" *-- "1" Menu : owns
Restaurant "1" *-- "1" Waiter : employs
Restaurant "1" *-- "1" Chef : employs
Restaurant "1" *-- "1" Cashier : employs
Restaurant "1" --> "0..*" Customer : registry and queue subset
Restaurant "1" --> "0..*" Order : active orders
Staff <|-- Waiter
Staff <|-- Chef
Staff <|-- Cashier
Customer <|-- RegularCustomer
Table "0..1" -- "0..1" Customer : current seating
Customer "1" -- "0..1" Order : places
Order "0..*" --> "1" MenuItem : item
Menu "1" *-- "3" MenuItem : contains
Customer ..> CustomerState
Order ..> OrderStatus
Waiter ..> Customer
Waiter ..> Table
Waiter ..> Order
Chef ..> Order
Cashier ..> Customer
Cashier ..> Order

